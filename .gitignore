# Rust / Cargo build output
/target/
**/*.rs.bk

# Backtraces
rustc-ice-*.txt

# Procedurally generated sound effects — synthesized at startup by
# audio_gen::generate(), so they are build artifacts, not source.
# The ElevenLabs-generated vehicle sounds (scripts/generate_sounds.py) are NOT
# reproducible without an API key, so they are committed (re-included below).
/assets/sounds/*
!/assets/sounds/engine_loop.wav
!/assets/sounds/engine_start.wav
!/assets/sounds/tire_screech.wav
!/assets/sounds/crash.wav
!/assets/sounds/ram_hit.wav

# Local secrets (OpenAI API key used to generate monster textures)
.env

# QC_GALLERY / QC_LEVELSHOT / QC_ITEMSHOT / QC_WEAPONSHOT debug screenshots
/gallery_*.png
/monster_gallery.png
/levelshot_*.png
/itemshot_*.png
/weaponshot_*.png

# Editor / OS cruft
*.swp
*~
.DS_Store

# Local Claude Code settings
.claude/settings.local.json
