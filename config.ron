// QUAKECLONE configuration — edit and restart the game.
// Any field you omit falls back to its default.
(
    // Fill the whole screen (borderless fullscreen). Set to false for a window.
    fullscreen: true,

    // Window size in pixels — used only when `fullscreen` is false.
    width: 1920,
    height: 1080,

    // Cap the frame rate to your monitor's refresh rate (prevents tearing).
    // Set to false to uncap — handy for reading the fps meter.
    vsync: true,

    // Which level a fresh run starts on: a number 1-11 (default 1), or "random".
    // Finishing a level still carries you into the next one regardless.
    start_level: "8",
)
